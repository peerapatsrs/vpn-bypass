{
  "name": "vpn-bypass",
  "version": "0.1.0",
  "description": "CLI and localhost UI that split-route IPv4 around a full-tunnel corporate VPN (home LAN for the web, intranet via VPN).",
  "bin": {
    "vpn-bypass": "bin/vpn-bypass.js"
  },
  "files": [
    "bin/",
    "src/",
    "ui/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
